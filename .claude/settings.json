{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__XcodeBuildMCP__test_.*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-direct-tests.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/test.sh*)",
      "Bash(./scripts/test.sh*)"
    ]
  }
}
